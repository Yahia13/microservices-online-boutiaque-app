// .devcontainer/devcontainer.json
{
  "name": "Ona Terraform/AWS workspace",

  // Base image (similar to what you had)
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  // Devcontainer Features to install tools
  "features": {
    // Basic utilities, non-root user, sudo, etc.
    "ghcr.io/devcontainers/features/common-utils:2": {},

    // AWS CLI v2
    "ghcr.io/devcontainers/features/aws-cli:1": {
      "version": "latest"
    },

    // Terraform (+ tflint / terragrunt disabled)
    "ghcr.io/devcontainers/features/terraform:1": {
      "version": "1.7.5",
      "tflint": "none",
      "terragrunt": "none"
    },

    // kubectl + Helm (no minikube)
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "version": "latest",
      "helm": "latest",
      "minikube": "none"
    },

    // Python + pip (for Ansible)
    "ghcr.io/devcontainers/features/python:1": {
      "version": "os-provided",
      "installTools": true
    }
  },

  // Match what you had in gitpod.yml
  "containerEnv": {
    "AWS_CLI_AUTO_PROMPT": "on-partial",
    "AWS_PAGER": ""
  },

  // Install tree, jq, unzip, and ansible like your old tasks
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y tree jq unzip python3-pip ansible && mkdir -p /workspace/.aws && echo 'export AWS_SHARED_CREDENTIALS_FILE=/workspace/.aws/credentials' >> ~/.zshrc && echo 'export AWS_CONFIG_FILE=/workspace/.aws/config' >> ~/.zshrc && echo 'export AWS_PROFILE=default' >> ~/.zshrc",

  "customizations": {
    "vscode": {
      "extensions": [
        "hashicorp.terraform",
        "AmazonWebServices.aws-toolkit-vscode",
        "ms-azuretools.vscode-docker",
        "ms-python.python",
        "redhat.ansible"
      ]
    }
  }
}
